#!/usr/bin/env bash

# use dunstify if installed, else notify-send (both take -u level, title, body)
notify() {
    DISPLAY="${DISPLAY:-:0}" DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}" \
        "$_notifier" "$@"
}
if command -v dunstify >/dev/null 2>&1; then
    _notifier=dunstify
elif command -v notify-send >/dev/null 2>&1; then
    _notifier=notify-send
else
    notify() { :; }
fi

GPU_AVAILABLE=0
if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
    GPU_AVAILABLE=1
fi

declare -a _prev_core_total _prev_core_idle
while read -r _lbl _u _n _s _i _io _irq _sirq _; do
    case "$_lbl" in
        cpu)
            _prev_total=$(( _u + _n + _s + _i + _io + _irq + _sirq ))
            _prev_idle=$(( _i + _io ))
            ;;
        cpu[0-9]*)
            _c="${_lbl#cpu}"
            _prev_core_total[$_c]=$(( _u + _n + _s + _i + _io + _irq + _sirq ))
            _prev_core_idle[$_c]=$(( _i + _io ))
            ;;
    esac
done < <(grep '^cpu' /proc/stat)

_notified_10=0
_notified_5=0

# the bar redraws a few times a second so a long music title can scroll smoothly,
# the other stats are only measured once a second
TICK=0.25
TICKS_PER_SECOND=4
# titles longer than this many characters scroll, MUSIC_WIDTH=15 is handy for testing
MUSIC_WIDTH="${MUSIC_WIDTH:-26}"
SCROLL_GAP="   ·   "
# how long a title stands still at its start before it scrolls
SCROLL_PAUSE_SECONDS=4
# music that stays paused this long drops off the bar until it plays again
PAUSED_HIDE_SECONDS="${PAUSED_HIDE_SECONDS:-600}"

# the entries on the bar, left to right; leave one out to hide it
ENTRIES=(music focus ram cpu governor gpu battery network date)

# the config can change ENTRIES and the settings above, and add entries of its own:
# a function entry_NAME prints the text for NAME and runs once a second
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/dwm-status/config"
# shellcheck disable=SC1090
[ -r "$CONFIG" ] && . "$CONFIG"
SCROLL_PAUSE_TICKS=$(( SCROLL_PAUSE_SECONDS * TICKS_PER_SECOND ))
declare -A CUSTOM

# reads the focus schedule (HH:MM-HH:MM per line, may wrap past midnight) and sets
# _focus_end to the end of the block we're in and _focus_next to the next block's start
focus_times() {
    local now line s e start end d best=1440
    now=$(( 10#$(date +%H) * 60 + 10#$(date +%M) ))
    _focus_end="" _focus_next=""
    while IFS= read -r line; do
        case $line in ''|'#'*) continue ;; esac
        start="${line%-*}" end="${line#*-}"
        s=$(( 10#${start%:*} * 60 + 10#${start#*:} ))
        e=$(( 10#${end%:*} * 60 + 10#${end#*:} ))
        if (( s <= e ? (now >= s && now < e) : (now >= s || now < e) )); then
            _focus_end="$end"
        fi
        d=$(( (s - now + 1440) % 1440 ))
        (( d > 0 && d < best )) && best=$d _focus_next="$start"
    done < /etc/focus/schedule
}

update_custom() {
    local name
    for name in "${ENTRIES[@]}"; do
        declare -F "entry_$name" >/dev/null && CUSTOM[$name]=$("entry_$name" 2>/dev/null)
    done
}

update_stats() {
    _max_core=0
    while read -r _lbl _u _n _s _i _io _irq _sirq _; do
        case "$_lbl" in
            cpu)
                _total=$(( _u + _n + _s + _i + _io + _irq + _sirq ))
                _idle=$(( _i + _io ))
                _dt=$(( _total - _prev_total ))
                _di=$(( _idle - _prev_idle ))
                _cpu_avg=$(( _dt > 0 ? (_dt - _di) * 100 / _dt : 0 ))
                _prev_total=$_total
                _prev_idle=$_idle
                ;;
            cpu[0-9]*)
                _c="${_lbl#cpu}"
                _total=$(( _u + _n + _s + _i + _io + _irq + _sirq ))
                _idle=$(( _i + _io ))
                _dt=$(( _total - _prev_core_total[$_c] ))
                _di=$(( _idle - _prev_core_idle[$_c] ))
                _pct=$(( _dt > 0 ? (_dt - _di) * 100 / _dt : 0 ))
                (( _pct > _max_core )) && _max_core=$_pct
                _prev_core_total[$_c]=$_total
                _prev_core_idle[$_c]=$_idle
                ;;
        esac
    done < <(grep '^cpu' /proc/stat)
    CPU="CPU $(printf '%3d' $_cpu_avg)% Max $(printf '%3d' $_max_core)%"

    DATE=$(date +"%a %d %b %H:%M")
    RAM=$(free | awk '/^Mem:/ {printf "RAM %3.0f%%", $3/$2 * 100}')

    GPU_ENTRY=""
    if [ "$GPU_AVAILABLE" -eq 1 ]; then
        if GPU_STATS=$(nvidia-smi \
              --query-gpu=utilization.gpu,memory.used,memory.total \
              --format=csv,noheader,nounits 2>/dev/null | head -n1); then
            read -r U MU MT <<<"${GPU_STATS//,/ }"
            VRAM_PER=$(awk "BEGIN{printf \"%3.0f\", $MU/$MT*100}")
            GPU_ENTRY="GPU $(printf '%3d' $U)% VRAM ${VRAM_PER}%"
        fi
    fi

    BATT_ENTRY=""
    if [ -d /sys/class/power_supply/BAT0 ]; then
        P=$(< /sys/class/power_supply/BAT0/capacity)
        S=$(< /sys/class/power_supply/BAT0/status)
        case "$S" in
            Charging)       BATT_ENTRY="⚡ $(printf '%3d' $P)%" ;;
            Discharging)    BATT_ENTRY="🔋 $(printf '%3d' $P)%" ;;
            Full)           BATT_ENTRY="🔌 $(printf '%3d' $P)%" ;;
            "Not charging") BATT_ENTRY="🚫🔌 $(printf '%3d' $P)%" ;;
            *)              BATT_ENTRY="? $(printf '%3d' $P)%" ;;
        esac

        [ "$P" -gt 10 ] && _notified_10=0
        [ "$P" -gt 5 ]  && _notified_5=0

        if [ "$S" = "Discharging" ]; then
            if [ "$P" -le 5 ] && [ "$_notified_5" -eq 0 ]; then
                notify -u critical "Battery critical" "${P}% remaining"
                _notified_5=1
            elif [ "$P" -le 10 ] && [ "$_notified_10" -eq 0 ]; then
                notify -u normal "Battery low" "${P}% remaining"
                _notified_10=1
            fi
        fi
    fi

    GOV=$(< /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)
    case "$GOV" in
        powersave)   GOV_ENTRY="🐢" ;;
        performance) GOV_ENTRY="🚀" ;;
        *)           GOV_ENTRY="$GOV" ;;
    esac

    # focus blocker: a target with the end of the current study block while it's on,
    # a coffee with the start of the next block in between, nothing once the focus period is over
    FOCUS_ENTRY=""
    if systemctl is-active --quiet focus-dns.service; then
        focus_times
        FOCUS_ENTRY="🎯 $_focus_end"
    elif systemctl is-active --quiet focus.timer; then
        focus_times
        FOCUS_ENTRY="☕ $_focus_next"
    fi

    # wifi network name, else ethernet when a real wired device is up (docker's are "connected (externally)")
    _ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '/^yes/{print $2}')
    if [ -n "$_ssid" ]; then
        NET_ENTRY="📶 ${_ssid:0:10}"
    elif nmcli -t -f TYPE,STATE device status 2>/dev/null | grep -qx 'ethernet:connected'; then
        NET_ENTRY="🌐 eth"
    else
        NET_ENTRY="📶 off"
    fi
}

# sets MUSIC_ENTRY to "icon title time", or empty when nothing is playing
_scroll_title="" _scroll_offset=0 _scroll_pause=0
_paused_title="" _paused_since=0
update_music() {
    # music-menu's mpv first, else whatever Spotify is playing (also the hidden one from spotify-menu)
    local line="" icon="" title="" time="" repeat=""
    if [ -r "${XDG_RUNTIME_DIR:-/tmp}/music-now" ]; then
        # the title, then the time into the track and its length on a second line
        { read -r line; read -r time; } < "${XDG_RUNTIME_DIR:-/tmp}/music-now"
        icon="${line%% *}" title="${line#* }"
    elif command -v playerctl >/dev/null 2>&1; then
        # status|loop|position/length|artist - title, with the title last since it may contain a |
        line=$(playerctl -p spotify metadata --format \
            '{{status}}|{{loop}}|{{duration(position)}}/{{duration(mpris:length)}}|{{artist}} - {{title}}' 2>/dev/null)
        local rest="${line#*|}"
        local loop="${rest%%|*}"
        rest="${rest#*|}"
        time="${rest%%|*}" title="${rest#*|}"
        case "${line%%|*}" in
            Playing) icon="♪" ;;
            Paused)  icon="⏸" ;;
            *)       title="" ;;
        esac
        # repeat one or repeat all, nothing when repeat is off
        case "$loop" in
            Track)    repeat="🔂" ;;
            Playlist) repeat="🔁" ;;
        esac
    fi

    # the pause clock starts over for every new title, so skipping while paused shows it again
    if [ "$icon" = "⏸" ]; then
        if [ "$title" != "$_paused_title" ]; then
            _paused_title="$title" _paused_since=$SECONDS
        fi
        (( SECONDS - _paused_since >= PAUSED_HIDE_SECONDS )) && title=""
    else
        _paused_title=""
    fi

    MUSIC_ENTRY=""
    [ -z "$title" ] && return

    # a new title starts scrolling from the beginning, after a pause
    if [ "$title" != "$_scroll_title" ]; then
        _scroll_title="$title" _scroll_offset=0 _scroll_pause=$SCROLL_PAUSE_TICKS
    fi

    # a long title scrolls left as a ticker: cut a window out of the title repeated twice
    local shown="$title"
    if [ ${#title} -gt "$MUSIC_WIDTH" ]; then
        local ticker="$title$SCROLL_GAP"
        shown="$ticker$ticker"
        shown="${shown:$_scroll_offset:$MUSIC_WIDTH}"
        if [ "$_scroll_pause" -gt 0 ]; then
            _scroll_pause=$(( _scroll_pause - 1 ))
        else
            _scroll_offset=$(( (_scroll_offset + 1) % ${#ticker} ))
            [ "$_scroll_offset" -eq 0 ] && _scroll_pause=$SCROLL_PAUSE_TICKS
        fi
    fi

    MUSIC_ENTRY="$icon $shown${time:+ $time}${repeat:+ $repeat}"
}

_tick=0
while true; do
    if (( _tick % TICKS_PER_SECOND == 0 )); then update_stats; update_custom; fi
    update_music
    _tick=$(( _tick + 1 ))

    parts=()
    for _name in "${ENTRIES[@]}"; do
        case $_name in
            music)    _v=$MUSIC_ENTRY ;;
            focus)    _v=$FOCUS_ENTRY ;;
            ram)      _v=$RAM ;;
            cpu)      _v=$CPU ;;
            governor) _v=$GOV_ENTRY ;;
            gpu)      _v=$GPU_ENTRY ;;
            battery)  _v=$BATT_ENTRY ;;
            network)  _v=$NET_ENTRY ;;
            date)     _v=$DATE ;;
            *)        _v=${CUSTOM[$_name]} ;;
        esac
        [ -n "$_v" ] && parts+=( "$_v" )
    done

    status="${parts[0]}"
    for _p in "${parts[@]:1}"; do status="$status | $_p"; done
    xsetroot -name "$status"

    sleep "$TICK"
done
